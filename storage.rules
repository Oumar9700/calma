rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars et photos de profil
    match /users/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Photos de plats — vendeur uniquement
    match /vendors/{vendorId}/dishes/{dishId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == vendorId;
    }

    // Captures de paiement — acheteur écrit, vendeur + acheteur lisent
    match /orders/{orderId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
